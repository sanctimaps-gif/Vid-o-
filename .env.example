# --- Rédaction des scripts (obligatoire) ---
# Clé API Anthropic : https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
# Modèle utilisé pour écrire les scripts (par défaut : claude-opus-5)
VIDO_MODEL=claude-opus-5

# --- Voix off ---
# edge | elevenlabs | none
VIDO_TTS=edge
# Voix Edge (gratuite, nécessite `pipx install edge-tts`) :
# fr-FR-DeniseNeural, fr-FR-HenriNeural, fr-FR-VivienneMultilingualNeural, en-US-AvaNeural...
VIDO_EDGE_VOICE=fr-FR-DeniseNeural
# Voix ElevenLabs (payant)
ELEVENLABS_API_KEY=
VIDO_ELEVENLABS_VOICE_ID=
VIDO_ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Rendu vidéo ---
VIDO_FFMPEG=ffmpeg
VIDO_FFPROBE=ffprobe
# Polices utilisées pour les textes incrustés (détectées automatiquement si vides)
VIDO_FONT_BOLD=
VIDO_FONT_REGULAR=
# Dossier de musiques de fond (.mp3/.m4a/.wav). Vide = pas de musique.
VIDO_MUSIC_DIR=assets/music

# --- Extraction du site ---
# Nombre max de pages produit explorées
VIDO_MAX_PAGES=14
# Respecter le robots.txt du site analysé (mettre false uniquement pour votre propre site)
VIDO_RESPECT_ROBOTS=true

# --- Serveur web ---
PORT=4173
