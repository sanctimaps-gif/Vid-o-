# Vid-O fonctionne sans aucune de ces variables : rendu local, rédacteur intégré,
# voix off gratuite. Ce fichier ne sert qu'à améliorer le résultat.

# --- Rédaction des scripts ---
# auto (défaut) | template | ollama | groq | gemini | openrouter | mistral | custom | anthropic
# "auto" retient, dans l'ordre : un serveur local, un palier gratuit en ligne, le rédacteur intégré.
VIDO_WRITER=auto

# Option 1 — Ollama en local : gratuit, sans compte, hors ligne.
#   https://ollama.com puis : ollama pull llama3.1:8b
OLLAMA_HOST=http://127.0.0.1:11434
VIDO_OLLAMA_MODEL=llama3.1:8b

# Option 2 — un palier gratuit en ligne. Une seule clé suffit, aucune n'exige de carte.
#   https://console.groq.com/keys
GROQ_API_KEY=
#   https://aistudio.google.com/apikey
GEMINI_API_KEY=
#   https://openrouter.ai/keys (modèles suffixés :free)
OPENROUTER_API_KEY=
#   https://console.mistral.ai
MISTRAL_API_KEY=
# Modèle à utiliser sur le fournisseur retenu (sinon, un modèle gratuit par défaut).
VIDO_LLM_MODEL=

# Option 3 — n'importe quel serveur compatible OpenAI (llama.cpp, LM Studio, vLLM).
VIDO_LLM_BASE_URL=
VIDO_LLM_API_KEY=

# Option 4 — Claude. Seule option facturée, jamais choisie automatiquement.
ANTHROPIC_API_KEY=
VIDO_MODEL=claude-opus-5

# --- Voix off ---
# edge | elevenlabs | none
# edge-tts est gratuit et ne demande aucun compte : pipx install edge-tts
VIDO_TTS=edge
# fr-FR-DeniseNeural, fr-FR-HenriNeural, fr-FR-VivienneMultilingualNeural, en-US-AvaNeural...
VIDO_EDGE_VOICE=fr-FR-DeniseNeural
# ElevenLabs : payant, facultatif.
ELEVENLABS_API_KEY=
VIDO_ELEVENLABS_VOICE_ID=
VIDO_ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Rendu vidéo ---
VIDO_FFMPEG=ffmpeg
VIDO_FFPROBE=ffprobe
# Polices des textes incrustés (détectées automatiquement si vides)
VIDO_FONT_BOLD=
VIDO_FONT_REGULAR=
# Dossier de musiques de fond (.mp3/.m4a/.wav). Vide = pas de musique.
VIDO_MUSIC_DIR=assets/music

# --- Extraction du site ---
VIDO_MAX_PAGES=14
# Respecter le robots.txt du site analysé (false uniquement pour votre propre site)
VIDO_RESPECT_ROBOTS=true

# --- Serveur web ---
PORT=4173
